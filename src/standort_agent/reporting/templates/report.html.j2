<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Standort Agent Report</title>

    <style>

        body {
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            max-width: 1100px;
            margin: 40px auto;
            padding: 0 24px;
            line-height: 1.6;
            color: #222;
        }

        h1 {
            margin-bottom: 4px;
        }

        .subtitle {
            color: #666;
            margin-top: 0;
        }

        .profile {
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #f5f5f5;
        }

        .score {
            font-weight: 700;
        }

        .location {
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            margin-bottom: 18px;
        }

        details {
            margin-top: 12px;
        }

        summary {
            cursor: pointer;
            font-weight: 600;
        }

        .signal {
            margin: 12px 0;
        }

        .footer {
            margin-top: 50px;
            color: #777;
            font-size: 0.9rem;
        }

    </style>

</head>


<body>

<h1>Standort Agent</h1>

<p class="subtitle">
    Explainable location recommendation report
</p>


<section class="profile">

    <h2>Business Profile</h2>

    <p>
        <strong>Industry:</strong>
        {{ profile.branche }}
    </p>

    <p>
        <strong>Required area:</strong>
        {{ profile.flaeche_m2 }} m²
    </p>

    <p>
        <strong>Target group:</strong>
        {{ profile.zielgruppe }}
    </p>

    <p>
        <strong>Monthly rent budget:</strong>
        €{{ "%.0f"|format(profile.budget_miete_eur) }}
    </p>

    <p>
        <strong>Preferred region:</strong>
        {{ profile.region_praeferenz if profile.region_praeferenz is string else profile.region_praeferenz | join(', ') }}
    </p>

</section>


<h2>Top Locations</h2>

<table>

    <thead>

        <tr>
            <th>Rank</th>
            <th>Municipality</th>
            <th>Overall</th>
            <th>Demographics</th>
            <th>POI</th>
            <th>Rent</th>
            <th>Transit</th>
        </tr>

    </thead>

    <tbody>

    {% for result in top_results %}

        <tr>

            <td>
                #{{ loop.index }}
            </td>

            <td>
                {{ result.municipality.gemeinde }}
            </td>

            <td class="score">
                {{ "%.1f"|format(result.total_score) }}
            </td>

            <td>
                {{ "%.1f"|format(
                    result.signals["demographics"].score
                ) }}
            </td>

            <td>
                {{ "%.1f"|format(
                    result.signals["poi"].score
                ) }}
            </td>

            <td>
                {{ "%.1f"|format(
                    result.signals["rent"].score
                ) }}
            </td>

            <td>
                {{ "%.1f"|format(
                    result.signals["transit"].score
                ) }}
            </td>

        </tr>

    {% endfor %}

    </tbody>

</table>


<h2>Location Explanations</h2>


{% for result in top_results %}

<section class="location">

    <h3>
        #{{ loop.index }}
        {{ result.municipality.gemeinde }}
    </h3>

    <p>
        <strong>
            Overall score:
        </strong>

        {{ "%.1f"|format(result.total_score) }}/100
    </p>


    <details>

        <summary>
            Show signal explanations
        </summary>


        <div class="signal">

            <strong>
                Demographics —
                {{ "%.1f"|format(
                    result.signals["demographics"].score
                ) }}/100
            </strong>

            <p>
                {{ result.signals["demographics"].reason }}
            </p>

        </div>


        <div class="signal">

            <strong>
                POI —
                {{ "%.1f"|format(
                    result.signals["poi"].score
                ) }}/100
            </strong>

            <p>
                {{ result.signals["poi"].reason }}
            </p>

        </div>


        <div class="signal">

            <strong>
                Rent —
                {{ "%.1f"|format(
                    result.signals["rent"].score
                ) }}/100
            </strong>

            <p>
                {{ result.signals["rent"].reason }}
            </p>

        </div>


        <div class="signal">

            <strong>
                Transit —
                {{ "%.1f"|format(
                    result.signals["transit"].score
                ) }}/100
            </strong>

            <p>
                {{ result.signals["transit"].reason }}
            </p>

        </div>

    </details>

</section>

{% endfor %}


{% if customer_explanation %}
<section class="location">
    <h2>What this means for your business</h2>
    {% for paragraph in customer_explanation.split('\n\n') %}
    <p>{{ paragraph }}</p>
    {% endfor %}
</section>
{% endif %}

<p class="footer">

    Scores are decision-support indicators based on the
    supplied synthetic municipality dataset and should not be
    interpreted as official location advice.

</p>

</body>

</html>
